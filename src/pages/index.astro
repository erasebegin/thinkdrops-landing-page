<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>thinkdrops | Revolutionizing Digital Education</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');

        :root {
            --primary: #6466F1;
            --primary-dark: #4f46e5;
            --secondary: #0f172a;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-light: #f8fafc;
            --white: #ffffff;
            --shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-light);
            background-image: url('/bg-pattern.svg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Utilities */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            padding: 0.8rem 1.8rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            border: none;
            font-size: 1rem;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 14px rgba(100, 102, 241, 0.4);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-outline {
            border: 2px solid var(--primary);
            color: var(--primary);
            background: transparent;
        }

        .btn-outline:hover {
            background: var(--primary);
            color: white;
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            height: 80px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            z-index: 1000;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .mobile-toggle {
            display: none;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
        }

        .mobile-toggle span {
            width: 25px;
            height: 3px;
            background: var(--primary);
            border-radius: 3px;
        }

        /* Hero Section */
        .hero {
            padding: 180px 0 100px;
            text-align: center;
            background: radial-gradient(circle at top right, rgba(100, 102, 241, 0.05), transparent),
                        radial-gradient(circle at bottom left, rgba(100, 102, 241, 0.05), transparent);
        }

        .hero h1 {
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            line-height: 1.1;
            font-weight: 800;
            margin-bottom: 1.5rem;
            letter-spacing: -2px;
            background: linear-gradient(135deg, #0f172a 0%, #6466F1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: clamp(1.1rem, 3vw, 1.4rem);
            color: var(--text-muted);
            max-width: 700px;
            margin: 0 auto 2.5rem;
        }

        /* Product Section */
        .section-title {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-title h2 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
            margin-bottom: 6rem;
        }

        .product-card {
            background: var(--white);
            padding: 3rem;
            border-radius: 24px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(0,0,0,0.03);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
        }

        .product-badge {
            background: rgba(100, 102, 241, 0.1);
            color: var(--primary);
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 700;
            align-self: flex-start;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
        }

        .product-card h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .product-card p {
            color: var(--text-muted);
            margin-bottom: 2rem;
            flex-grow: 1;
        }

        .feature-list {
            list-style: none;
            margin-bottom: 2rem;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 0.8rem;
            font-weight: 500;
        }

        .feature-list li::before {
            content: '✓';
            color: var(--primary);
            font-weight: 800;
        }

        /* Special T-Class Section */
        .tclass-highlight {
            background: var(--secondary);
            color: var(--white);
            padding: 6rem 0;
            border-radius: 40px;
            margin: 4rem 0;
            position: relative;
            overflow: hidden;
        }

        .tclass-highlight::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: var(--primary);
            filter: blur(150px);
            opacity: 0.15;
            z-index: 0;
        }

        .tclass-content {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .tclass-text h2 {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .tclass-text p {
            opacity: 0.8;
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        .teacher-tag {
            display: inline-block;
            background: var(--primary);
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        /* Footer */
        footer {
            padding: 6rem 0 3rem;
            background: #fff;
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }

        .footer-logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .footer-col h4 {
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 0.8rem;
        }

        .footer-col ul li a {
            text-decoration: none;
            color: var(--text-muted);
            transition: var(--transition);
        }

        .footer-col ul li a:hover {
            color: var(--primary);
        }

        .copyright {
            padding-top: 2rem;
            border-top: 1px solid rgba(0,0,0,0.05);
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .reveal {
            animation: fadeIn 0.8s ease forwards;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .tclass-content {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .products-grid {
                gap: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none; /* In a real app, this would be a drawer */
            }
            .mobile-toggle {
                display: flex;
            }
            .products-grid {
                grid-template-columns: 1fr;
            }
            .hero h1 {
                margin-top: 2rem;
            }
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 480px) {
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .btn {
                width: 100%;
                justify-content: center;
            }
            .product-card {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>

    <nav>
        <div class="container">
            <a href="#" class="logo"><img src="/logo.png" alt="thinkdrops" width="72" height="72" style="display:block" /></a>
            <div class="nav-links">
                <a href="#products">Products</a>
                <a href="#about">Our Story</a>
                <a href="#tclass" class="btn btn-primary" style="color: white; padding: 0.6rem 1.2rem;">Get Started</a>
            </div>
            <div class="mobile-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container reveal">
            <h1>The platform built by teachers, for the future of learning.</h1>
            <p>Empowering educators with AI-driven tools and an all-in-one ecosystem designed from a decade of classroom experience.</p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="#products" class="btn btn-primary">Explore Products</a>
                <a href="#about" class="btn btn-outline">Our Philosophy</a>
            </div>
        </div>
    </header>

    <section id="products" class="container">
        <div class="section-title reveal">
            <h2>Ecosystem of Innovation</h2>
            <p>Streamline your workflow from quiz generation to full classroom management.</p>
        </div>

        <div class="products-grid">
            <!-- T-Quiz Card -->
            <div class="product-card reveal" style="animation-delay: 0.1s;">
                <span class="product-badge">AI Powered</span>
                <h3>T-quiz</h3>
                <p>The ultimate AI quiz generator. Transform any content—articles, videos, or notes—into comprehensive assessments in seconds.</p>
                <ul class="feature-list">
                    <li>Instant generation from URLs/Files</li>
                    <li>Multiple question formats</li>
                    <li>Automatic grading & analytics</li>
                    <li>Direct export to T-Class</li>
                </ul>
                <a href="https://quiz.thinkdrops.co.uk" class="btn btn-outline">Learn more about T-quiz</a>
            </div>

            <!-- T-Class Card -->
            <div class="product-card reveal" style="animation-delay: 0.2s; border: 2px solid var(--primary);">
                <span class="product-badge" style="background: var(--primary); color: white;">Flagship Platform</span>
                <h3>T-Class</h3>
                <p>The 360° virtual campus. A full-featured online teaching platform that lets freelance teachers run their entire business in one place.</p>
                <ul class="feature-list">
                    <li>Interactive Digital Blackboard</li>
                    <li>Teaching Material Library</li>
                    <li>Integrated AI Quiz Suite</li>
                    <li>Freelance Business Tools</li>
                </ul>
                <a href="https://edu.thinkdrops.co.uk" class="btn btn-primary">Discover T-Class</a>
            </div>
        </div>
    </section>

    <section id="tclass" class="container reveal">
        <div class="tclass-highlight">
            <div class="container">
                <div class="tclass-content">
                    <div class="tclass-text">
                        <span class="teacher-tag">Pedagogy-First Design</span>
                        <h2>A Classroom Built by an Educator of 10+ Years</h2>
                        <p>Most teaching software is built by engineers who haven't spent a day in the classroom. T-Class is different. Every feature—from the library management to the blackboard interactions—was designed by a teacher with a decade of experience to solve the actual frustrations of digital instruction.</p>
                        <ul class="feature-list" style="margin-bottom: 2rem; color: white;">
                            <li>Do 100% of your work within the platform</li>
                            <li>Integrated curriculum builders</li>
                            <li>Seamless freelance student management</li>
                        </ul>
                        <a href="https://edu.thinkdrops.co.uk" class="btn btn-primary" style="background: white; color: var(--secondary);">Experience T-Class</a>
                    </div>
                    <div class="tclass-visual" style="background: rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; text-align: center;">
                        <i data-lucide="graduation-cap" style="font-size: 5rem;"></i>
                        <h4 style="font-size: 1.5rem; margin-top: 1rem;">Teacher-Centric</h4>
                        <p style="font-size: 0.9rem; opacity: 0.7;">Engineered for flow, not friction.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="container" style="padding: 6rem 2rem; text-align: center;">
        <div class="reveal" style="max-width: 800px; margin: 0 auto;">
            <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Why thinkdrops?</h2>
            <p style="font-size: 1.2rem; color: var(--text-muted); line-height: 1.8;">
                We believe that technology should amplify the teacher, not replace them. thinkdrops was founded to bridge the gap between complex pedagogical needs and modern AI capabilities. We provide the tools, so you can focus on what matters: <strong>the student.</strong>
            </p>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <div class="footer-logo"><img src="/logo.png" alt="thinkdrops" width="56" height="56" style="display:block" /></div>
                    <p style="color: var(--text-muted);">Redefining the digital classroom through teacher-led innovation and intelligent automation.</p>
                </div>
                <div class="footer-col">
                    <h4>Products</h4>
                    <ul>
                        <li><a href="https://quiz.thinkdrops.co.uk">T-quiz AI</a></li>
                        <li><a href="https://edu.thinkdrops.co.uk">T-Class Platform</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="#">Our Story</a></li>
                        <li><a href="mailto:contact@thinkdrops.co.uk">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                &copy; 2026 thinkdrops education software. All rights reserved.
            </div>
        </div>
    </footer>

    <script>
        // Reveal elements on scroll
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('reveal');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
            el.style.opacity = "0";
            observer.observe(el);
        });

        // Initialize Lucide icons
        lucide.createIcons();

        // Mobile menu toggle simple logic
        document.querySelector('.mobile-toggle').addEventListener('click', () => {
            alert('Navigation menu would expand here in a full implementation.');
        });
    </script>
</body>
</html>